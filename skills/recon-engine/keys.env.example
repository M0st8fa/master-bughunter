# recon-engine provider keys — COPY to keys.env (git-ignored) or export in your shell.
# NEVER commit real keys. Rotate immediately if a real key is ever committed.
VT_API_KEYS=your_virustotal_key_here        # optional; comma-separate multiple
SHODAN_API_KEY=your_shodan_key_here          # optional

# recon.sh (canonical Recon-Script) notifications are Slack/Discord webhooks, passed as
# runtime flags (--slack/--discord <webhook>), not env keys — so nothing for them here.
