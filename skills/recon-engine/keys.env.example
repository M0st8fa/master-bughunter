# recon-engine provider keys — COPY to keys.env (git-ignored) or export in your shell.
# NEVER commit real keys. Rotate immediately if a real key is ever committed.
VT_API_KEYS=your_virustotal_key_here        # optional; comma-separate multiple
SHODAN_API_KEY=your_shodan_key_here          # optional

# Telegram notifications for recon.sh (run summary + per-finding alerts).
# Leave empty to disable. The bot token is a CREDENTIAL — never commit a real one.
# Create a bot via @BotFather; get your chat id from @userinfobot or getUpdates.
TELEGRAM_BOT_TOKEN=                           # optional; e.g. 123456789:AA... (no quotes)
TELEGRAM_CHAT_ID=                             # optional; e.g. 123456789 or -1001234567890
